# ===== KeeperHub MCP =====
# KeeperHub MCP endpoint (Streamable HTTP)
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp
# 你的 KeeperHub API Key (Bearer)，从 KeeperHub 控制台获取
KEEPERHUB_API_KEY=

# ===== Wallet (经 KeeperHub 开通的非托管钱包) =====
WALLET_ADDRESS=0x1573C3d151200922375bC48012BB1f232B2cF531
# KeeperHub 钱包集成 ID (如用到)
WALLET_INTEGRATION_ID=flx4bwzye6tb6re68wost

# ===== Chain =====
# Sepolia testnet (chainId 11155111)。主网改 "1"
CHAIN_ID=11155111

# ===== 监控目标 =====
# 被 HealthFactor agent 监控的 Aave V3 地址 (空=用内置 mock 演示)
MONITOR_ADDRESS=
# Rebalancing agent 直接指定的 PancakeSwap V3 LP tokenId (逗号分隔, 可选)
TOKEN_IDS=

# ===== 安全开关 =====
# true=只生成计划+审计, 绝不真发交易 (默认, 强烈建议先 dry_run)
# false=PROTECT action 会经 KeeperHub 真还债 (Aave V3)
DRY_RUN=true

# ===== 执行上限 (USD) =====
MAX_REBALANCE_USD=10000
